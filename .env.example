# ── Gmail MCP Gateway — environment variables ─────────────────────────────────
# Copy this to .env and fill in your values.
# .env is gitignored — never commit it.

# Required in production: a strong random string used as a Bearer token.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to run without auth (dev / localhost only).
GATEWAY_API_KEY=

# Port the HTTP server listens on (default 8000).
PORT=8000

# Host to bind. 0.0.0.0 = all interfaces (required for Pi / Docker).
# Use 127.0.0.1 for local-only development.
HOST=0.0.0.0

# Path to the SQLite token database.
# Default: ~/.gmail-mcp-tokens.db
# In Docker: set to /data/tokens.db and mount a persistent volume at /data.
DB_PATH=

# ── Google OAuth credentials ───────────────────────────────────────────────────
# Option A (preferred): drop the JSON downloaded from Google Cloud Console
#   next to server.py as  .gmail-mcp-oauth.json  — no env vars needed.
# Option B: set these two vars (handy for Docker secrets / CI).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
